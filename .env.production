# URL API Gateway Dinamis (Production / Build)
# Menggunakan /api/v1 agar otomatis mengikuti domain aktif saat di-deploy (seperti https://pelita.pkm.asia/api/v1)
VITE_API_BASE_URL=/api/v1

# Skenario A: Aktifkan Panel & Tombol Simulasi Pembayaran Sandbox (Staging / Demo Server)
VITE_ENABLE_SANDBOX_SIMULATOR=true

# Opsional: Google Gemini Vision API Key
VITE_GEMINI_API_KEY=
