# URL API Gateway Go (Default: http://localhost:8000/api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Skenario A: Aktifkan Panel & Tombol Simulasi Pembayaran Sandbox (Staging / Demo Server)
# Setel ke 'true' untuk server demo agar pimpinan/panitia dapat menguji alur lunas tanpa uang riil.
# Setel ke 'false' saat siap rilis ke server produksi publik riil (Skenario B).
VITE_ENABLE_SANDBOX_SIMULATOR=true

# Opsional: Google Gemini Vision API Key untuk akurasi pemindaian e-KTP instan 100%
# (Bisa juga dimasukkan langsung oleh pendaftar melalui tombol 'Gunakan API AI' di jendela pemindai KTP)
VITE_GEMINI_API_KEY=
